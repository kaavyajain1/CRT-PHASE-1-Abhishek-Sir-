class Solution {
public:
    int rob(vector<int>& nums) {
        int n = nums.size();
        if (n == 0) return 0;
        if (n == 1) return nums[0];

        int prev2 = 0;        // Max money 2 houses ago
        int prev1 = 0;        // Max money 1 house ago
        
        for (int x : nums) {
            // Decision: rob current (x + prev2) OR skip current (prev1)
            int current = max(prev1, prev2 + x);
            
            // Move pointers forward
            prev2 = prev1;
            prev1 = current;
        }
        
        return prev1;
    }
};
