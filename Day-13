#include <iostream>
using namespace std;

int solve(int n) {
    if (n < 4) {
        return 1;
    }
    return solve(n - 4) + solve(n - 1);
}

int main() {
    int n; 
    
    cout << "Enter the value of n: ";
    cin >> n;
    cout << "Total ways for n=" << n << " is: " << solve(n) << endl;
    
    return 0;
}


